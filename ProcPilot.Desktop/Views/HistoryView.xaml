<UserControl x:Class="ProcPilot.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Light">
    <UserControl.Resources>
        <Style x:Key="ProcessDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F2F6F9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
        </Style>

        <Style x:Key="ProcessDataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B9CBD8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0,8,8" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="ProcessDataGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F2F6F9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="34" />
        </Style>

        <Style x:Key="ProcessDataGridCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F2F6F9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style x:Key="AnimatedCard" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="14" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryTableContainer" TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasHistory}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistoryEmptyState" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasHistory}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="#2A2A2A"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                Padding="22,18,22,10"
                Style="{StaticResource HistoryTableContainer}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,18">
                    <TextBlock Text="Process history"
                               Foreground="#F2F6F9"
                               FontSize="15" />
                    <TextBlock Text="Completed process runs"
                               Foreground="#B9CBD8"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Entries}"
                          Style="{StaticResource ProcessDataGrid}"
                          ColumnHeaderStyle="{StaticResource ProcessDataGridHeader}"
                          RowStyle="{StaticResource ProcessDataGridRow}"
                          CellStyle="{StaticResource ProcessDataGridCell}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PROCESS" Binding="{Binding ProcessName}" Width="1.7*" />
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="0.8*" />
                        <DataGridTextColumn Header="STARTED" Binding="{Binding StartedAt}" Width="1.5*" />
                        <DataGridTextColumn Header="ENDED" Binding="{Binding EndedAt}" Width="1.5*" />
                        <DataGridTextColumn Header="DURATION" Binding="{Binding Duration}" Width="1.1*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Background="#242424" Style="{StaticResource HistoryEmptyState}">
            <Border Background="#2A2A2A"
                    BorderBrush="#6B899E"
                    BorderThickness="1"
                    Padding="28"
                    Style="{StaticResource AnimatedCard}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="No process history yet"
                               Foreground="#F2F6F9"
                               FontSize="19"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Completed process runs will appear here when history tracking is connected."
                               Foreground="#B9CBD8"
                               FontSize="12"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
