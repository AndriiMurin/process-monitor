<Window x:Class="ProcPilot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProcPilot.Desktop.Converters"
         xmlns:views="clr-namespace:ProcPilot.Desktop.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
         Title="ProcPilot Task Manager"
        Height="720"
        Width="1120"
        MinHeight="600"
        MinWidth="900"
           WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
          ResizeMode="CanResize"
          Background="#081321"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="28" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SideNavigationButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B9C7D8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Padding" Value="8,9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1" /></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Background" Value="#123F5A" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.04" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.04" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D3DFE8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,0,0,10" />
            <Setter Property="Margin" Value="0,0,29,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E9F4FC" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PanelSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8FA6BC" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F8FBFD" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#08B9D8" />
            <Setter Property="Foreground" Value="#062033" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#24D4EC" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#35D8ED" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#315267" />
                                <Setter Property="Foreground" Value="#89A6B8" />
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AnimatedPage" TargetType="Grid">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="14" /></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.34" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AnimatedCard" TargetType="Border">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="10" /></Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.4" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProcessDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#101E2E" />
            <Setter Property="Foreground" Value="#DCE9F3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="ProcessDataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#91A9BE" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#294157" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="0,0,0,9" />
        </Style>

        <Style x:Key="ProcessDataGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="#101E2E" />
            <Setter Property="Foreground" Value="#DCE9F3" />
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#20364A" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#162F47" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#075A86" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProcessDataGridCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="#101E2E" />
            <Setter Property="Foreground" Value="#DCE9F3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ProcessNumericCell" TargetType="DataGridCell" BasedOn="{StaticResource ProcessDataGridCell}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="0,0,10,0" />
        </Style>
    </Window.Resources>

    <Border Margin="0" Background="#081321" BorderBrush="#24384C" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="204" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0B1625" BorderBrush="#203247" BorderThickness="0,0,1,0">
                <Grid Margin="10,16,10,14">
                    <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,0">
                        <Border Width="26" Height="26" Background="#05BBDD" CornerRadius="6" Margin="0,0,9,0">
                            <TextBlock Text="&#xE700;" Foreground="#082033" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ProcPilot" Foreground="#F5FBFF" FontWeight="SemiBold" FontSize="14" />
                            <Border Width="1" Height="18" Background="#456177" Margin="12,0" />
                            <TextBlock Text="Process Monitor" Foreground="#93A7BC" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                     <StackPanel Grid.Row="1" Margin="0,22,0,0">
                         <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource SideNavigationButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}" /><TextBlock Text="Dashboard" VerticalAlignment="Center" /></StackPanel></Button>
                         <Button Command="{Binding NavigateCommand}" CommandParameter="Processes" Style="{StaticResource SideNavigationButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80A;" Style="{StaticResource NavIcon}" /><TextBlock Text="Processes" VerticalAlignment="Center" /></StackPanel></Button>
                         <Button Command="{Binding NavigateCommand}" CommandParameter="Performance" Style="{StaticResource SideNavigationButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}" /><TextBlock Text="Performance" VerticalAlignment="Center" /></StackPanel></Button>
                         <Button Command="{Binding NavigateCommand}" CommandParameter="History" Style="{StaticResource SideNavigationButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}" /><TextBlock Text="History" VerticalAlignment="Center" /></StackPanel></Button>
                         <Button Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource SideNavigationButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}" /><TextBlock Text="Settings" VerticalAlignment="Center" /></StackPanel></Button>
                    </StackPanel>

                </Grid>
            </Border>

             <Grid Grid.Column="1" Margin="0" Background="#0B1625">
                <Grid.RowDefinitions>
                     <RowDefinition Height="38" />
                     <RowDefinition Height="1" />
                     <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                     <TextBlock Text="Auto refresh" Foreground="#93A7BC" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                         <Button Content="—" Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Foreground="#E8F1F6" Background="Transparent" BorderThickness="0" FontSize="16" Width="32" Height="30" Cursor="Hand" ToolTip="Minimize" />
                         <Button Content="□" Click="MaximizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Foreground="#E8F1F6" Background="Transparent" BorderThickness="0" FontSize="14" Width="32" Height="30" Cursor="Hand" ToolTip="Maximize or restore" />
                        <Button Content="×" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Foreground="#E8F1F6" Background="Transparent" BorderThickness="0" FontSize="19" Width="32" Height="30" Cursor="Hand" ToolTip="Close" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#20364A" Margin="0" />

                <StackPanel Grid.Row="2" Margin="16,0,16,0" VerticalAlignment="Center">
                     <TextBlock Text="{Binding PageTitle}" Foreground="#F5FBFF" FontSize="21" FontWeight="SemiBold" />
                     <TextBlock Text="{Binding PageSubtitle}" Foreground="#93A7BC" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>

                 <Grid Grid.Row="3" Margin="16,0,16,12">
                    <Grid Visibility="{Binding IsDashboard, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource AnimatedPage}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                         <Grid Grid.Row="0" Margin="0,0,0,18">
                         <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                             <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Running processes" Style="{StaticResource PanelTitle}" />
                                <TextBlock Text="Live process count" Style="{StaticResource PanelSubtitle}" Margin="0,4,0,15" />
                                <TextBlock Text="{Binding ProcessCount}" Style="{StaticResource MetricValue}" />
                                 <ProgressBar Value="100" Height="2" Margin="0,14,0,0" Foreground="#10C6E5" Background="#29445A" />
                            </StackPanel>

                             <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                 <TextBlock Text="Process data" Style="{StaticResource PanelTitle}" />
                                 <TextBlock Text="Live backend metrics" Style="{StaticResource PanelSubtitle}" Margin="0,4,0,15" />
                                 <TextBlock Text="{Binding CpuUsage}" Style="{StaticResource MetricValue}" />
                                <ProgressBar Value="65" Height="2" Margin="0,14,0,0" Foreground="#10C6E5" Background="#29445A" />
                            </StackPanel>
                        </Grid>

                         <Border Grid.Row="1" Background="#111F30" BorderBrush="#263C52" BorderThickness="1" CornerRadius="8" Padding="16,14,16,8" Style="{StaticResource AnimatedCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,9">
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="*" />
                                         <ColumnDefinition Width="215" />
                                         <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Process activity" Foreground="#F2F6F9" FontSize="15" />
                                     <Grid Grid.Column="1" Width="200" HorizontalAlignment="Center">
                                        <TextBox x:Name="ProcessFilterBox"
                                                 Text="{Binding ProcessFilterText, UpdateSourceTrigger=PropertyChanged}"
                                                 Foreground="#EAF5FA"
                                                  Background="#17283A"
                                                  BorderBrush="#167E9A"
                                                 BorderThickness="0,0,0,1"
                                                 FontSize="11"
                                                 Padding="28,5,8,5"
                                                 ToolTip="Search processes by name" />
                                        <TextBlock Text="⌕"
                                                   IsHitTestVisible="False"
                                                   Foreground="#B9CBD8"
                                                   FontSize="17"
                                                   Margin="8,0,0,1"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=ProcessFilterBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{Binding ProcessCount, StringFormat={}{0} processes detected}" Foreground="#B9CBD8" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                 <DataGrid Grid.Row="1" ItemsSource="{Binding ProcessesView}" SelectedItem="{Binding SelectedProcess, Mode=TwoWay}" Style="{StaticResource ProcessDataGrid}" ColumnHeaderStyle="{StaticResource ProcessDataGridHeader}" RowStyle="{StaticResource ProcessDataGridRow}" CellStyle="{StaticResource ProcessDataGridCell}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="PROCESS" Width="2.3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="#11C7E5" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="1.1*" />
                                        <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="1.1*" />
                                        <DataGridTextColumn Header="MEMORY" Binding="{Binding Memory}" Width="1.1*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding IsProcesses, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource AnimatedPage}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#111F30" BorderBrush="#263C52" BorderThickness="1" CornerRadius="8" Padding="4,0,4,4" Style="{StaticResource AnimatedCard}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /><RowDefinition Height="46" /></Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="10,7,10,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#05C7E5" Margin="0,0,9,0" />
                                        <TextBlock Text="Running processes" Foreground="#F5FBFF" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#17283A" BorderBrush="#38536B" BorderThickness="1" CornerRadius="6" Margin="8,0,8,0">
                                        <Grid>
                                            <TextBox x:Name="ProcessesSearchBox" Text="{Binding ProcessFilterText, UpdateSourceTrigger=PropertyChanged}" Foreground="#EAF5FA" Background="Transparent" BorderThickness="0" Padding="30,7,8,7" FontSize="11" ToolTip="Search processes by name" />
                                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" IsHitTestVisible="False" Foreground="#8FA6BC" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Search processes by name" IsHitTestVisible="False" Foreground="#7189A0" FontSize="11" Margin="30,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ProcessesSearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <Button Grid.Column="2" Content="&#xE8B5;" FontFamily="Segoe MDL2 Assets" Command="{Binding RefreshCommand}" Foreground="#DDEAF5" Background="#20364A" BorderBrush="#3B5D78" BorderThickness="1" Padding="11,7" Cursor="Hand" ToolTip="Refresh process list" />
                                </Grid>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding ProcessesView}" SelectedItem="{Binding SelectedProcess, Mode=TwoWay}" Style="{StaticResource ProcessDataGrid}" ColumnHeaderStyle="{StaticResource ProcessDataGridHeader}" RowStyle="{StaticResource ProcessDataGridRow}" CellStyle="{StaticResource ProcessDataGridCell}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="PROCESS" Width="2.2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#11C7E5" Margin="4,0,10,0" VerticalAlignment="Center" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="1*" CellStyle="{StaticResource ProcessNumericCell}" />
                                        <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="1*" CellStyle="{StaticResource ProcessNumericCell}" />
                                        <DataGridTextColumn Header="RAM" Binding="{Binding Memory}" Width="1.2*" CellStyle="{StaticResource ProcessNumericCell}" />
                                        <DataGridTextColumn Header="UPTIME" Binding="{Binding Uptime}" Width="1.1*" CellStyle="{StaticResource ProcessNumericCell}" />
                                        <DataGridTemplateColumn Header="STATUS" Width="1.1*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#20D86B" Margin="0,0,7,0" /><TextBlock Text="Running" Foreground="#B9D2C5" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Grid.Row="2" Margin="10,0">
                                    <TextBlock
                                        Text="{Binding ProcessCount, StringFormat=Showing all {0} processes}"
                                        Foreground="#8EA4B9"
                                        FontSize="10"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Text="Live list · refreshes automatically"
                                        Foreground="#7189A0"
                                        FontSize="10"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />
                                </Grid>
                                </Grid>
                                </Border>
                        <Border Grid.Column="2" Background="#111F30" BorderBrush="#263C52" BorderThickness="1" CornerRadius="8" Padding="14" Style="{StaticResource AnimatedCard}">
                            <StackPanel>
                                <Grid><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" Background="#0A5A91" CornerRadius="8" Margin="0,0,10,0"><TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" Foreground="#6EE9FF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel><TextBlock Text="{Binding SelectedProcessName}" Foreground="#F5FBFF" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Running process" Foreground="#91A9BE" FontSize="10" /></StackPanel></StackPanel></Grid>
                                <Border Background="#123D35" CornerRadius="10" Padding="8,4" HorizontalAlignment="Left" Margin="48,8,0,15"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#20D86B" Margin="0,0,6,0" /><TextBlock Text="Running" Foreground="#67E69A" FontSize="10" /></StackPanel></Border>
                                <Border Height="1" Background="#294156" Margin="0,0,0,12" />
                                <TextBlock Text="Details" Foreground="#F5FBFF" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="PID" Foreground="#8EA4B9" /><TextBlock Grid.Row="0" Text="{Binding SelectedProcessPid}" Foreground="#DCE9F3" HorizontalAlignment="Right" /><TextBlock Grid.Row="1" Text="CPU" Foreground="#8EA4B9" Margin="0,10,0,0" /><TextBlock Grid.Row="1" Text="{Binding SelectedProcessCpu}" Foreground="#05C7E5" HorizontalAlignment="Right" Margin="0,10,0,0" /><TextBlock Grid.Row="2" Text="RAM" Foreground="#8EA4B9" Margin="0,10,0,0" /><TextBlock Grid.Row="2" Text="{Binding SelectedProcessMemory}" Foreground="#DCE9F3" HorizontalAlignment="Right" Margin="0,10,0,0" /><TextBlock Grid.Row="3" Text="Uptime" Foreground="#8EA4B9" Margin="0,10,0,0" /><TextBlock Grid.Row="3" Text="{Binding SelectedProcessUptime}" Foreground="#DCE9F3" HorizontalAlignment="Right" Margin="0,10,0,0" /></Grid>
                                <Border Height="1" Background="#294156" Margin="0,18,0,14" />
                                <TextBlock Text="Resource usage" Foreground="#F5FBFF" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,9" />
                                <Border Background="#172A3C" BorderBrush="#29445C" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8"><Grid><TextBlock Text="CPU" Foreground="#A9BCD0" /><TextBlock Text="{Binding SelectedProcessCpu}" Foreground="#05C7E5" FontSize="15" HorizontalAlignment="Right" /></Grid></Border>
                                <Border Background="#172A3C" BorderBrush="#29445C" BorderThickness="1" CornerRadius="6" Padding="10"><Grid><TextBlock Text="RAM" Foreground="#A9BCD0" /><TextBlock Text="{Binding SelectedProcessMemory}" Foreground="#DCE9F3" FontSize="15" HorizontalAlignment="Right" /></Grid></Border>
                                <TextBlock Text="Actions" Foreground="#F5FBFF" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,9" />
                                <Button Content="End process" Command="{Binding TerminateProcessCommand}" Background="#123D55" Foreground="#6EE9FF" BorderBrush="#167E9A" BorderThickness="1" Padding="9" HorizontalAlignment="Stretch" Cursor="Hand" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding IsPerformance, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource AnimatedPage}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="218" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Hidden">
                                <StackPanel>
                                    <TextBlock Text="Performance" Foreground="#F2F2F2" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <Button Command="{Binding SelectPerformanceCommand}" CommandParameter="CPU" Background="#2B2B2B" Foreground="#F2F2F2" BorderThickness="0" Padding="9" Margin="0,0,0,4" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Width="62" Height="52" Background="#252525" BorderBrush="#555555" BorderThickness="1">
                                                <Polyline Points="2,35 10,34 18,36 26,20 34,29 42,12" Stroke="#35B7E8" StrokeThickness="1" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                <TextBlock Text="CPU" FontSize="13" />
                                                <TextBlock Text="{Binding CpuSummary}" Foreground="#B9CBD8" FontSize="10" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding SelectPerformanceCommand}" CommandParameter="Memory" Background="#2B2B2B" Foreground="#F2F2F2" BorderThickness="0" Padding="9" Margin="0,0,0,4" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Width="62" Height="52" Background="#252525" BorderBrush="#555555" BorderThickness="1">
                                                <Polyline Points="2,35 10,27 18,30 26,19 34,23 42,8" Stroke="#8BE28B" StrokeThickness="1" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                <TextBlock Text="Memory" FontSize="13" />
                                                <TextBlock Text="{Binding MemoryPercentDisplay}" Foreground="#B9CBD8" FontSize="10" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Border Background="#2B2B2B" Padding="11" Margin="0,0,0,4"><StackPanel><TextBlock Text="Disk 0 (C:)" FontSize="13" /><TextBlock Text="Unavailable" Foreground="#A0A0A0" FontSize="10" Margin="0,3,0,0" /></StackPanel></Border>
                                    <Border Background="#2B2B2B" Padding="11" Margin="0,0,0,4"><StackPanel><TextBlock Text="Ethernet" FontSize="13" /><TextBlock Text="Unavailable" Foreground="#A0A0A0" FontSize="10" Margin="0,3,0,0" /></StackPanel></Border>
                                    <Border Background="#2B2B2B" Padding="11"><StackPanel><TextBlock Text="GPU" FontSize="13" /><TextBlock Text="Unavailable" Foreground="#A0A0A0" FontSize="10" Margin="0,3,0,0" /></StackPanel></Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Column="2" Background="#191919" BorderBrush="#414141" BorderThickness="1" Padding="14,12,14,12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding SelectedPerformanceTitle}" Foreground="#F2F2F2" FontSize="29" FontFamily="Segoe UI" />
                                        <TextBlock Text="{Binding SelectedPerformanceValue}" Foreground="#D9D9D9" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Row="1" Background="#191919">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Grid.Column="0" Stretch="Fill" Visibility="{Binding IsCpuPerformance, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid Width="800" Height="300">
                                                <Canvas Width="800" Height="300">
                                                    <Line X1="0" Y1="0" X2="800" Y2="0" Stroke="#303030" /><Line X1="0" Y1="60" X2="800" Y2="60" Stroke="#303030" /><Line X1="0" Y1="120" X2="800" Y2="120" Stroke="#303030" /><Line X1="0" Y1="180" X2="800" Y2="180" Stroke="#303030" /><Line X1="0" Y1="240" X2="800" Y2="240" Stroke="#303030" /><Line X1="0" Y1="299" X2="800" Y2="299" Stroke="#303030" />
                                                    <Line X1="80" Y1="0" X2="80" Y2="300" Stroke="#292929" /><Line X1="160" Y1="0" X2="160" Y2="300" Stroke="#292929" /><Line X1="240" Y1="0" X2="240" Y2="300" Stroke="#292929" /><Line X1="320" Y1="0" X2="320" Y2="300" Stroke="#292929" /><Line X1="400" Y1="0" X2="400" Y2="300" Stroke="#292929" /><Line X1="480" Y1="0" X2="480" Y2="300" Stroke="#292929" /><Line X1="560" Y1="0" X2="560" Y2="300" Stroke="#292929" /><Line X1="640" Y1="0" X2="640" Y2="300" Stroke="#292929" /><Line X1="720" Y1="0" X2="720" Y2="300" Stroke="#292929" />
                                                    <Polygon Points="{Binding CpuAreaPoints}" Fill="#5C2C7890" StrokeThickness="0" Panel.ZIndex="1" />
                                                    <Polyline x:Name="CpuGraph" Stroke="#35B7E8" StrokeThickness="2" StrokeLineJoin="Round" Panel.ZIndex="2" />
                                                </Canvas>
                                            </Grid>
                                        </Viewbox>
                                        <Viewbox Grid.Column="0" Stretch="Fill" Visibility="{Binding IsMemoryPerformance, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid Width="800" Height="300">
                                                <Canvas Width="800" Height="300">
                                                    <Line X1="0" Y1="0" X2="800" Y2="0" Stroke="#303030" /><Line X1="0" Y1="60" X2="800" Y2="60" Stroke="#303030" /><Line X1="0" Y1="120" X2="800" Y2="120" Stroke="#303030" /><Line X1="0" Y1="180" X2="800" Y2="180" Stroke="#303030" /><Line X1="0" Y1="240" X2="800" Y2="240" Stroke="#303030" /><Line X1="0" Y1="299" X2="800" Y2="299" Stroke="#303030" />
                                                    <Polygon Points="{Binding MemoryAreaPoints}" Fill="#5C4F9B5F" StrokeThickness="0" Panel.ZIndex="1" />
                                                    <Polyline x:Name="MemoryGraph" Stroke="#8BE28B" StrokeThickness="2" StrokeLineJoin="Round" Panel.ZIndex="2" />
                                                </Canvas>
                                            </Grid>
                                        </Viewbox>
                                        <Grid Grid.Column="1" Margin="6,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="100%" Foreground="#B8B8B8" FontSize="10" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="1" Text="50%" Foreground="#B8B8B8" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="2" Text="0%" Foreground="#B8B8B8" FontSize="10" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Grid>
                                    <Grid Grid.Row="2" Margin="0,8,0,0"><TextBlock Text="60 seconds" Foreground="#9B9B9B" FontSize="10" /><TextBlock Text="0" Foreground="#9B9B9B" FontSize="10" HorizontalAlignment="Right" /></Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Visibility="{Binding IsSettings, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource AnimatedPage}">
                        <Border Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" Padding="22" Style="{StaticResource AnimatedCard}">
                            <StackPanel>
                                <TextBlock Text="Settings" Foreground="#F2F6F9" FontSize="19" />
                                <TextBlock Text="Customize monitoring preferences." Foreground="#B9CBD8" FontSize="12" Margin="0,6,0,24" />
                                <CheckBox Content="Enable automatic refresh" IsChecked="{Binding IsAutoRefreshEnabled, Mode=TwoWay}" Foreground="#EEF5FA" Margin="0,0,0,15" />
                                <CheckBox Content="Show system processes" IsChecked="{Binding ShowSystemProcesses, Mode=TwoWay}" Foreground="#EEF5FA" Margin="0,0,0,25" />
                                <Button Command="{Binding SaveSettingsCommand}" Content="Save settings" Width="125" HorizontalAlignment="Left" Background="#42D4E8" Foreground="#163D58" BorderThickness="0" Padding="12,8" Cursor="Hand" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <views:HistoryView DataContext="{Binding History}"
                                       Visibility="{Binding DataContext.IsHistory, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
