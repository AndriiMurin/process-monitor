<Window x:Class="ProcPilot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProcPilot.Desktop.Converters"
        Title="Process Monitor"
        Height="760"
        Width="1360"
        MinHeight="640"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#4288F5">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D9E7FF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3280F4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4288F5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8996AC" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E2A43" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="ProcessDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="ProcessDataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#8996AC" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0,0,0,12" />
        </Style>

        <Style x:Key="ProcessDataGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#263653" />
            <Setter Property="Height" Value="48" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5FC" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E9F0FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProcessDataGridCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#263653" />
        </Style>
    </Window.Resources>

    <Border Margin="18" CornerRadius="28" Background="#4288F5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="305" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="30,38,26,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="WORKSPACE" Foreground="#C8DCFF" FontSize="10" FontWeight="Bold" Margin="0,0,0,12" />
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource NavigationButton}" Content="  Dashboard" />
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Processes" Style="{StaticResource NavigationButton}" Content="  Processes" />
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Performance" Style="{StaticResource NavigationButton}" Content="  Performance" />
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource NavigationButton}" Content="  Settings" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="MONITORING STATUS" Foreground="#C8DCFF" FontSize="10" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Ellipse Width="9" Height="9" Fill="#B9FFD9" VerticalAlignment="Center" />
                        <TextBlock Text="  System is healthy" Foreground="White" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" Margin="0,18,18,18" CornerRadius="24" Background="#F7F9FD" Padding="34,30,34,28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding PageTitle}" Foreground="#1E2A43" FontSize="29" FontWeight="Bold" />
                            <TextBlock Text="{Binding PageSubtitle}" Foreground="#8996AC" FontSize="13" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LastUpdated}" Foreground="#8996AC" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Button Command="{Binding RefreshCommand}" Content="Refresh" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,27,0,0">
                        <Grid Visibility="{Binding IsDashboard, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,23">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="White" CornerRadius="13" Padding="18">
                                    <StackPanel><TextBlock Text="CPU USAGE" Style="{StaticResource CardTitle}" /><TextBlock Text="Not available" Style="{StaticResource CardValue}" FontSize="18" Margin="0,8,0,2" /><TextBlock Text="Backend metric pending" Foreground="#8996AC" FontSize="11" /></StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="White" CornerRadius="13" Padding="18">
                                    <StackPanel><TextBlock Text="MEMORY USAGE" Style="{StaticResource CardTitle}" /><TextBlock Text="Not available" Style="{StaticResource CardValue}" FontSize="18" Margin="0,8,0,2" /><TextBlock Text="Backend metric pending" Foreground="#8996AC" FontSize="11" /></StackPanel>
                                </Border>
                                <Border Grid.Column="4" Background="White" CornerRadius="13" Padding="18">
                                    <StackPanel><TextBlock Text="ACTIVE PROCESSES" Style="{StaticResource CardTitle}" /><TextBlock Text="{Binding ProcessCount}" Style="{StaticResource CardValue}" Margin="0,8,0,2" /><TextBlock Text="Live backend result" Foreground="#42A879" FontSize="11" /></StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,13">
                                <TextBlock Text="Running processes" Foreground="#1E2A43" FontSize="19" FontWeight="Bold" />
                                <TextBlock Text="{Binding ProcessCount, StringFormat={}{0} processes found}" Foreground="#8996AC" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Border Grid.Row="2" Background="White" CornerRadius="13" Padding="20,16,20,8">
                                <DataGrid ItemsSource="{Binding Processes}" Style="{StaticResource ProcessDataGrid}" ColumnHeaderStyle="{StaticResource ProcessDataGridHeader}" RowStyle="{StaticResource ProcessDataGridRow}" CellStyle="{StaticResource ProcessDataGridCell}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="PROCESS" Width="2.2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding IndicatorColor}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="1.1*" />
                                        <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="1.1*" />
                                        <DataGridTextColumn Header="MEMORY" Binding="{Binding Memory}" Width="1.1*" />
                                        <DataGridTextColumn Header="UPTIME" Binding="{Binding Uptime}" Width="1.4*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>

                        <Grid Visibility="{Binding IsProcesses, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Background="White" CornerRadius="13" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="All processes" Foreground="#1E2A43" FontSize="19" FontWeight="Bold" />
                                    <TextBlock Text="Live data from the process monitoring backend" Foreground="#8996AC" Margin="0,6,0,20" />
                                    <DataGrid ItemsSource="{Binding Processes}" Style="{StaticResource ProcessDataGrid}" ColumnHeaderStyle="{StaticResource ProcessDataGridHeader}" RowStyle="{StaticResource ProcessDataGridRow}" CellStyle="{StaticResource ProcessDataGridCell}" Height="380">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="PROCESS" Binding="{Binding Name}" Width="2*" />
                                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C24141" TextWrapping="Wrap" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Visibility="{Binding IsPerformance, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Performance" Foreground="#1E2A43" FontSize="19" FontWeight="Bold" />
                                <TextBlock Text="The current backend exposes process identity only. Resource charts can be connected when CPU and memory metrics are added." Foreground="#8996AC" Margin="0,6,0,18" TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="White" CornerRadius="13" Padding="20">
                                        <StackPanel><TextBlock Text="CPU USAGE" Style="{StaticResource CardTitle}" /><TextBlock Text="N/A" Style="{StaticResource CardValue}" Margin="0,10,0,8" /><Canvas Height="170"><Line X1="0" Y1="40" X2="410" Y2="40" Stroke="#DDE5F2" StrokeDashArray="3,5" /><Line X1="0" Y1="100" X2="410" Y2="100" Stroke="#DDE5F2" StrokeDashArray="3,5" /><Polyline Points="0,140 55,105 110,120 165,72 220,96 275,55 330,78 410,34" Stroke="#4288F5" StrokeThickness="4" /></Canvas></StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="White" CornerRadius="13" Padding="20">
                                        <StackPanel><TextBlock Text="MEMORY USAGE" Style="{StaticResource CardTitle}" /><TextBlock Text="N/A" Style="{StaticResource CardValue}" Margin="0,10,0,8" /><Canvas Height="170"><Line X1="0" Y1="40" X2="410" Y2="40" Stroke="#DDE5F2" StrokeDashArray="3,5" /><Line X1="0" Y1="100" X2="410" Y2="100" Stroke="#DDE5F2" StrokeDashArray="3,5" /><Polyline Points="0,130 55,115 110,125 165,94 220,106 275,71 330,82 410,51" Stroke="#42A879" StrokeThickness="4" /></Canvas></StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding IsSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Background="White" CornerRadius="13" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="Settings" Foreground="#1E2A43" FontSize="19" FontWeight="Bold" />
                                    <TextBlock Text="Customize the appearance of your monitoring dashboard." Foreground="#8996AC" Margin="0,6,0,22" />
                                    <TextBlock Text="COLOR THEME" Style="{StaticResource CardTitle}" />
                                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" Margin="0,10,0,22" Padding="8">
                                        <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Rectangle Width="22" Height="22" Fill="{Binding AccentBrush}" RadiusX="5" RadiusY="5" Margin="0,0,10,0" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <CheckBox Content="Enable automatic refresh" IsChecked="{Binding IsAutoRefreshEnabled, Mode=TwoWay}" Foreground="#263653" Margin="0,0,0,14" />
                                    <CheckBox Content="Show system processes" IsChecked="{Binding ShowSystemProcesses, Mode=TwoWay}" Foreground="#263653" Margin="0,0,0,24" />
                                    <Button Command="{Binding SaveSettingsCommand}" Content="Save settings" Style="{StaticResource PrimaryButton}" Width="130" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
