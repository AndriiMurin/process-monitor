<Window x:Class="ProcPilot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProcPilot.Desktop.Converters"
        Title="ProcPilot"
        Height="720"
        Width="1240"
        MinHeight="620"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{Binding SelectedTheme.WindowBrush}">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A8B1C5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{Binding SelectedTheme.AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AnimatedView" TargetType="Grid">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="14" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.34" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AnimatedPageItem" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="10" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AnimatedDashboardItem" BasedOn="{StaticResource AnimatedPageItem}" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDashboard}" Value="True">
                    <DataTrigger.EnterActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" BeginTime="0:0:0.05" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.38" BeginTime="0:0:0.05" />
                    </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AnimatedProcessesItem" BasedOn="{StaticResource AnimatedPageItem}" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProcesses}" Value="True">
                    <DataTrigger.EnterActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" BeginTime="0:0:0.08" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.38" BeginTime="0:0:0.08" />
                    </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AnimatedPerformanceItem" BasedOn="{StaticResource AnimatedPageItem}" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPerformance}" Value="True">
                    <DataTrigger.EnterActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" BeginTime="0:0:0.08" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.38" BeginTime="0:0:0.08" />
                    </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AnimatedSettingsItem" BasedOn="{StaticResource AnimatedPageItem}" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSettings}" Value="True">
                    <DataTrigger.EnterActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" BeginTime="0:0:0.08" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.38" BeginTime="0:0:0.08" />
                    </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding SelectedTheme.MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding SelectedTheme.HeadingBrush}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{Binding SelectedTheme.SidebarBrush}">
            <Grid Margin="20,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" Background="{Binding SelectedTheme.AccentBrush}" CornerRadius="10">
                        <TextBlock Text="P" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="ProcPilot" Margin="12,0,0,0" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="WORKSPACE" Foreground="#66728B" FontSize="10" FontWeight="Bold" Margin="6,0,0,10" />
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource NavigationButton}" Content="  Dashboard" />
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Processes" Style="{StaticResource NavigationButton}" Content="  Processes" />
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Performance" Style="{StaticResource NavigationButton}" Content="  Performance" />
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource NavigationButton}" Content="  Settings" />
                </StackPanel>

                <Border Grid.Row="4" Background="{Binding SelectedTheme.SidebarPanelBrush}" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="MONITORING STATUS" Foreground="#7F8BA4" FontSize="10" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse Width="8" Height="8" Fill="#42D392" VerticalAlignment="Center" />
                            <TextBlock Text="  System is healthy" Foreground="#E5EAF4" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="34,28,34,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Foreground="{Binding SelectedTheme.HeadingBrush}" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="{Binding PageSubtitle}" Foreground="{Binding SelectedTheme.MutedBrush}" FontSize="13" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastUpdated}" Foreground="{Binding SelectedTheme.MutedBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Command="{Binding RefreshCommand}" Content="Refresh" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,28,0,0">
                <Grid x:Name="DashboardView" Visibility="{Binding IsDashboard, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource AnimatedView}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,24" Style="{StaticResource AnimatedDashboardItem}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{Binding SelectedTheme.CardBrush}" CornerRadius="12" Padding="20" Style="{StaticResource AnimatedDashboardItem}">
                            <StackPanel Style="{StaticResource AnimatedDashboardItem}"><TextBlock Text="CPU USAGE" Style="{StaticResource CardTitle}" /><TextBlock Text="24.8%" Style="{StaticResource CardValue}" Margin="0,8,0,2" /><TextBlock Text="↑ 4.2% from last hour" Foreground="#42A879" FontSize="11" /></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{Binding SelectedTheme.CardBrush}" CornerRadius="12" Padding="20" Style="{StaticResource AnimatedDashboardItem}">
                            <StackPanel Style="{StaticResource AnimatedDashboardItem}"><TextBlock Text="MEMORY USAGE" Style="{StaticResource CardTitle}" /><TextBlock Text="6.4 GB" Style="{StaticResource CardValue}" Margin="0,8,0,2" /><TextBlock Text="of 16 GB available" Foreground="{Binding SelectedTheme.MutedBrush}" FontSize="11" /></StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="{Binding SelectedTheme.CardBrush}" CornerRadius="12" Padding="20" Style="{StaticResource AnimatedDashboardItem}">
                            <StackPanel Style="{StaticResource AnimatedDashboardItem}"><TextBlock Text="ACTIVE PROCESSES" Style="{StaticResource CardTitle}" /><TextBlock Text="142" Style="{StaticResource CardValue}" Margin="0,8,0,2" /><TextBlock Text="↑ 8 since last scan" Foreground="#42A879" FontSize="11" /></StackPanel>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,14" Style="{StaticResource AnimatedDashboardItem}">
                        <TextBlock Text="Running processes" Foreground="{Binding SelectedTheme.HeadingBrush}" FontSize="19" FontWeight="Bold" Style="{StaticResource AnimatedDashboardItem}" />
                        <TextBlock Text="142 processes found" Foreground="{Binding SelectedTheme.MutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AnimatedDashboardItem}" />
                    </Grid>
                    <Border Grid.Row="2" Background="{Binding SelectedTheme.CardBrush}" CornerRadius="12" Padding="0,8,0,0" Style="{StaticResource AnimatedDashboardItem}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PROCESS" Style="{StaticResource CardTitle}" Margin="20,0" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="PID" Style="{StaticResource CardTitle}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="CPU" Style="{StaticResource CardTitle}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="MEMORY" Style="{StaticResource CardTitle}" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="UPTIME" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                            <Border Grid.Row="1" Grid.ColumnSpan="5" Background="#EEF1F6" />
                            <ItemsControl Grid.Row="2" Grid.ColumnSpan="5" ItemsSource="{Binding Processes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="52">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center"><Ellipse Width="9" Height="9" Fill="{Binding IndicatorColor}" Margin="0,0,10,0" /><TextBlock Text="{Binding Name}" Foreground="{Binding DataContext.SelectedTheme.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" /></StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Pid}" Foreground="#66728A" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding Cpu}" Foreground="#263247" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="{Binding Memory}" Foreground="#263247" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="{Binding Uptime}" Foreground="#66728A" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Visibility="{Binding IsProcesses, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource AnimatedView}">
                    <Border Background="{Binding SelectedTheme.CardBrush}" CornerRadius="12" Padding="24" Style="{StaticResource AnimatedProcessesItem}"><StackPanel><TextBlock Text="All processes" Foreground="{Binding SelectedTheme.HeadingBrush}" FontSize="19" FontWeight="Bold" /><TextBlock Text="Static preview of the process list" Foreground="{Binding SelectedTheme.MutedBrush}" Margin="0,6,0,22" /><TextBlock Text="No live process data is connected yet." Foreground="{Binding SelectedTheme.TextBrush}" FontSize="14" /><Button Command="{Binding RefreshCommand}" Content="Refresh process list" Style="{StaticResource PrimaryButton}" Width="170" HorizontalAlignment="Left" Margin="0,24,0,0" /></StackPanel></Border>
                </Grid>

                <Grid Visibility="{Binding IsPerformance, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource AnimatedView}">
                    <Border Background="{Binding SelectedTheme.CardBrush}" CornerRadius="12" Padding="24" Style="{StaticResource AnimatedPerformanceItem}"><StackPanel><TextBlock Text="Performance" Foreground="{Binding SelectedTheme.HeadingBrush}" FontSize="19" FontWeight="Bold" /><TextBlock Text="Static resource usage preview" Foreground="{Binding SelectedTheme.MutedBrush}" Margin="0,6,0,22" /><TextBlock Text="CPU history" Style="{StaticResource CardTitle}" /><ProgressBar Value="24.8" Maximum="100" Height="12" Margin="0,10,0,22" Foreground="{Binding SelectedTheme.AccentBrush}" /><TextBlock Text="Memory history" Style="{StaticResource CardTitle}" /><ProgressBar Value="40" Maximum="100" Height="12" Margin="0,10,0,0" Foreground="#42A879" /></StackPanel></Border>
                </Grid>

                <Grid Visibility="{Binding IsSettings, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource AnimatedView}">
                    <Border Background="{Binding SelectedTheme.CardBrush}" CornerRadius="12" Padding="24" Style="{StaticResource AnimatedSettingsItem}"><StackPanel><TextBlock Text="Settings" Foreground="{Binding SelectedTheme.HeadingBrush}" FontSize="19" FontWeight="Bold" /><TextBlock Text="Customize the colors and presentation of your dashboard." Foreground="{Binding SelectedTheme.MutedBrush}" Margin="0,6,0,22" /><TextBlock Text="COLOR THEME" Style="{StaticResource CardTitle}" /><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" Margin="0,10,0,22" Padding="8"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Rectangle Width="22" Height="22" Fill="{Binding AccentBrush}" RadiusX="5" RadiusY="5" Margin="0,0,10,0" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><CheckBox Content="Enable automatic refresh" IsChecked="{Binding IsAutoRefreshEnabled, Mode=TwoWay}" Foreground="{Binding SelectedTheme.TextBrush}" Margin="0,0,0,14" /><CheckBox Content="Show system processes" IsChecked="{Binding ShowSystemProcesses, Mode=TwoWay}" Foreground="{Binding SelectedTheme.TextBrush}" Margin="0,0,0,24" /><Button Command="{Binding SaveSettingsCommand}" Content="Save settings" Style="{StaticResource PrimaryButton}" Width="130" HorizontalAlignment="Left" /></StackPanel></Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
